# === تنظیمات تلگرام ===
# این فایل را به .env کپی کنید و مقادیر را پر کنید
#cp .env.example .env

# توکن ربات تلگرام (از @BotFather بگیرید)
TELEGRAM_BOT_TOKEN=

# شناسه چت یا کانال (مثلاً @yourchannel یا 123456789)
TELEGRAM_CHAT_ID=

# === تنظیمات CoinGecko (اختیاری) ===
# کلید API برای رفع محدودیت نرخ (از https://www.coingecko.com/api)
# اگر خالی باشد، از API رایگان عمومی استفاده می‌شود
COINGECKO_API_KEY=
